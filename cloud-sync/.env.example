# Gere duas chaves aleatórias diferentes, cada uma com 32+ caracteres.
# Chave de leitura: configure uma vez no PC do Nico e no PC do Val.
SYNC_READ_TOKEN=COLOQUE_UMA_CHAVE_DE_LEITURA_COM_32_OU_MAIS_CARACTERES
# Chave de publicação: guarde somente no PC do administrador.
SYNC_ADMIN_TOKEN=COLOQUE_UMA_CHAVE_ADMINISTRATIVA_COM_32_OU_MAIS_CARACTERES
PORT=3030
DATA_FILE=/data/shared-config.json
