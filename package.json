{
  "name": "nicovalbolalibre-desktop",
  "version": "0.18.2",
  "description": "Central de partidas NicoValBolaLibre para Windows",
  "private": true,
  "main": "electron/main.js",
  "author": "NicoValBolaLibre",
  "license": "UNLICENSED",
  "scripts": {
    "test:navigation": "node scripts/test-navigation-guard.js",
    "start": "electron .",
    "dist:win": "electron-builder --config build/electron-builder.config.js --win nsis",
    "release:win": "electron-builder --config build/electron-builder.config.js --win nsis --publish always",
    "test:competition-ranking": "node scripts/test-competition-ranking.js",
    "test:team-logos": "node scripts/test-team-logo-index.js",
    "test:apifootball": "node scripts/test-apifootball.js",
    "test:cloud-sports-sync": "node scripts/test-cloudflare-sports-data.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
